// BitStockerz API Prisma schema
// Sprint 4 adds paper accounts, positions, market orders, and executions on top
// of the Sprint 2–3 strategy/backtest and Sprint 1.x platform tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String    @id @db.Char(36)
  email        String    @unique
  displayName  String?   @map("display_name") @db.VarChar(255)
  baseCurrency String    @default("USD") @map("base_currency") @db.VarChar(8)
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  webauthnCredentials WebAuthnCredential[]
  authSessions        AuthSession[]
  oauthIdentities     OAuthIdentity[]
  jobs                Job[]
  auditEvents         AuditEvent[]
  strategies          Strategy[]
  backtestRuns        BacktestRun[]
  paperAccount        PaperAccount?
  aiUsage             AiUsage[]

  @@map("users")
}

model AuthSession {
  token     String   @id @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model OAuthIdentity {
  provider  String   @db.VarChar(16)
  subject   String   @db.VarChar(255)
  userId    String   @map("user_id") @db.Char(36)
  email     String?  @db.VarChar(191)
  createdAt DateTime @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, subject])
  @@index([userId])
  @@map("oauth_identities")
}

model WebAuthnChallenge {
  id        String   @id @db.Char(36)
  purpose   String   @db.VarChar(16)
  email     String   @db.VarChar(191)
  challenge String   @db.VarChar(512)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

model OAuthState {
  state     String   @id @db.VarChar(128)
  provider  String   @db.VarChar(16)
  nonce     String   @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")

  @@index([expiresAt])
  @@map("oauth_states")
}

model AiUsage {
  id     Int      @id @default(autoincrement()) @db.UnsignedInt
  userId String   @map("user_id") @db.Char(36)
  date   DateTime @db.Date
  calls  Int

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date], map: "uq_ai_usage_user_date")
  @@map("ai_usage")
}

model AuditEvent {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  userId      String?  @map("user_id") @db.Char(36)
  eventType   String   @map("event_type") @db.VarChar(64)
  payloadJson Json     @map("payload_json")
  createdAt   DateTime @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_events")
}

model Job {
  id           String    @id @db.Char(36)
  jobType      String    @map("job_type") @db.VarChar(32)
  userId       String    @map("user_id") @db.Char(36)
  payloadJson  Json      @map("payload_json")
  status       String    @db.VarChar(16)
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @map("created_at")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  user         User          @relation(fields: [userId], references: [id])
  backtestRuns BacktestRun[]

  @@index([userId, createdAt])
  @@index([jobType, status])
  @@map("jobs")
}

model WebAuthnCredential {
  credentialId String   @id @map("credential_id") @db.VarChar(255)
  userId       String   @map("user_id") @db.Char(36)
  publicKey    String   @map("public_key") @db.Text
  signCount    BigInt   @map("sign_count")
  transports   String?  @map("transports")
  aaguid       String?  @map("aaguid")
  createdAt    DateTime @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("webauthn_credentials")
}

model Strategy {
  id          String   @id @db.Char(36)
  userId      String   @map("user_id") @db.Char(36)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  assetType   String   @map("asset_type") @db.VarChar(16)
  symbolScope String   @map("symbol_scope") @db.VarChar(16)
  timeframe   String   @db.VarChar(8)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions     StrategyVersion[]
  backtestRuns BacktestRun[]

  @@unique([userId, name], map: "uq_strategies_user_name")
  @@index([userId], map: "idx_strategies_user")
  @@map("strategies")
}

model StrategyVersion {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  strategyId     String   @map("strategy_id") @db.Char(36)
  versionNumber  Int      @map("version_number")
  definitionJson Json     @map("definition_json")
  createdAt      DateTime @map("created_at")

  strategy     Strategy      @relation(fields: [strategyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  backtestRuns BacktestRun[]

  @@unique([strategyId, versionNumber], map: "uq_strategy_versions")
  @@index([strategyId], map: "idx_strategy_versions_strategy")
  @@map("strategy_versions")
}

model Symbol {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  symbol     String   @unique @db.VarChar(32)
  name       String   @db.VarChar(255)
  assetType  String   @map("asset_type") @db.VarChar(16)
  exchange   String?  @db.VarChar(64)
  currency   String   @db.VarChar(16)
  baseAsset  String?  @map("base_asset") @db.VarChar(32)
  quoteAsset String?  @map("quote_asset") @db.VarChar(32)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @map("created_at")
  updatedAt  DateTime @map("updated_at")

  equityDailyBars  EquityDailyBar[]
  cryptoDailyBars  CryptoDailyBar[]
  cryptoHourlyBars CryptoHourlyBar[]
  backtestRuns     BacktestRun[]
  backtestTrades   BacktestTrade[]
  orders           Order[]
  executions       Execution[]
  positions        Position[]

  @@index([assetType])
  @@map("symbols")
}

model EquityDailyBar {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  symbolId  Int      @map("symbol_id") @db.UnsignedInt
  date      DateTime @db.Date
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    BigInt
  provider  String   @db.VarChar(64)
  createdAt DateTime @map("created_at")

  symbol Symbol @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, date])
  @@index([symbolId, date])
  @@map("equity_daily_bars")
}

model CryptoDailyBar {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  symbolId  Int      @map("symbol_id") @db.UnsignedInt
  date      DateTime @db.Date
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    Decimal  @db.Decimal(24, 8)
  provider  String   @db.VarChar(64)
  createdAt DateTime @map("created_at")

  symbol Symbol @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, date])
  @@index([symbolId, date])
  @@map("crypto_daily_bars")
}

model CryptoHourlyBar {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  symbolId  Int      @map("symbol_id") @db.UnsignedInt
  timestamp DateTime @map("ts")
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    Decimal  @db.Decimal(24, 8)
  provider  String   @db.VarChar(64)
  createdAt DateTime @map("created_at")

  symbol Symbol @relation(fields: [symbolId], references: [id])

  @@unique([symbolId, timestamp])
  @@index([symbolId, timestamp])
  @@map("crypto_hourly_bars")
}

model BacktestRun {
  id                String    @id @db.Char(36)
  userId            String    @map("user_id") @db.Char(36)
  strategyId        String    @map("strategy_id") @db.Char(36)
  strategyVersionId Int       @map("strategy_version_id") @db.UnsignedInt
  symbolId          Int       @map("symbol_id") @db.UnsignedInt
  timeframe         String    @db.VarChar(8)
  startDate         DateTime  @map("start_date")
  endDate           DateTime  @map("end_date")
  initialEquity     Decimal   @map("initial_equity") @db.Decimal(18, 2)
  status            String    @db.VarChar(16)
  jobId             String?   @map("job_id") @db.Char(36)
  errorMessage      String?   @map("error_message") @db.Text
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")
  startedAt         DateTime? @map("started_at")
  finishedAt        DateTime? @map("finished_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  strategy        Strategy        @relation(fields: [strategyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  symbol          Symbol          @relation(fields: [symbolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  job             Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  result       BacktestResult?
  trades       BacktestTrade[]
  equityPoints BacktestEquityPoint[]

  @@index([userId, createdAt], map: "idx_backtests_user_created")
  @@index([strategyId], map: "idx_backtests_strategy")
  @@index([symbolId], map: "idx_backtests_symbol")
  @@map("backtest_runs")
}

model BacktestResult {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  backtestRunId  String   @unique(map: "uq_backtest_results_run") @map("backtest_run_id") @db.Char(36)
  finalEquity    Decimal  @map("final_equity") @db.Decimal(18, 2)
  totalReturnPct Decimal  @map("total_return_pct") @db.Decimal(9, 4)
  maxDrawdownPct Decimal  @map("max_drawdown_pct") @db.Decimal(9, 4)
  winRatePct     Decimal  @map("win_rate_pct") @db.Decimal(9, 4)
  numTrades      Int      @map("num_trades")
  avgWinPct      Decimal  @map("avg_win_pct") @db.Decimal(9, 4)
  avgLossPct     Decimal  @map("avg_loss_pct") @db.Decimal(9, 4)
  sharpeRatio    Decimal? @map("sharpe_ratio") @db.Decimal(9, 4)

  run BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("backtest_results")
}

model BacktestTrade {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  backtestRunId String   @map("backtest_run_id") @db.Char(36)
  symbolId      Int      @map("symbol_id") @db.UnsignedInt
  entryTime     DateTime @map("entry_time")
  exitTime      DateTime @map("exit_time")
  side          String   @db.VarChar(8)
  entryPrice    Decimal  @map("entry_price") @db.Decimal(18, 8)
  exitPrice     Decimal  @map("exit_price") @db.Decimal(18, 8)
  quantity      Decimal  @db.Decimal(18, 8)
  pnlAbs        Decimal  @map("pnl_abs") @db.Decimal(18, 8)
  pnlPct        Decimal  @map("pnl_pct") @db.Decimal(9, 4)

  run    BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  symbol Symbol      @relation(fields: [symbolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([backtestRunId, entryTime], map: "idx_backtest_trades_run_entry")
  @@index([symbolId], map: "idx_backtest_trades_symbol")
  @@map("backtest_trades")
}

model BacktestEquityPoint {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  backtestRunId String   @map("backtest_run_id") @db.Char(36)
  timestamp     DateTime @map("ts")
  equity        Decimal  @db.Decimal(18, 2)

  run BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([backtestRunId, timestamp], map: "idx_backtest_equity_run_ts")
  @@map("backtest_equity_points")
}

model PaperAccount {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  userId          String   @unique(map: "uq_paper_account_user") @map("user_id") @db.Char(36)
  name            String   @db.VarChar(255)
  baseCurrency    String   @map("base_currency") @db.VarChar(16)
  startingBalance Decimal  @map("starting_balance") @db.Decimal(18, 2)
  cashBalance     Decimal  @map("cash_balance") @db.Decimal(18, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders     Order[]
  executions Execution[]
  positions  Position[]

  @@map("paper_accounts")
}

model Position {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  paperAccountId Int      @map("paper_account_id") @db.UnsignedInt
  symbolId       Int      @map("symbol_id") @db.UnsignedInt
  quantity       Decimal  @db.Decimal(18, 8)
  avgCost        Decimal  @map("avg_cost") @db.Decimal(20, 8)
  updatedAt      DateTime @map("updated_at")

  account PaperAccount @relation(fields: [paperAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  symbol  Symbol       @relation(fields: [symbolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([paperAccountId, symbolId], map: "uq_positions_account_symbol")
  @@index([paperAccountId], map: "idx_positions_account")
  @@index([symbolId], map: "idx_positions_symbol")
  @@map("positions")
}

model Order {
  id             String    @id @db.Char(36)
  paperAccountId Int       @map("paper_account_id") @db.UnsignedInt
  symbolId       Int       @map("symbol_id") @db.UnsignedInt
  side           String    @db.VarChar(8)
  quantity       Decimal   @db.Decimal(18, 8)
  orderType      String    @map("order_type") @db.VarChar(16)
  status         String    @db.VarChar(16)
  avgFillPrice   Decimal?  @map("avg_fill_price") @db.Decimal(20, 8)
  rejectReason   String?   @map("reject_reason") @db.VarChar(255)
  clientOrderId  String?   @map("client_order_id") @db.VarChar(64)
  requestedAt    DateTime  @map("requested_at")
  filledAt       DateTime? @map("filled_at")

  account    PaperAccount @relation(fields: [paperAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  symbol     Symbol       @relation(fields: [symbolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  executions Execution[]

  @@unique([paperAccountId, clientOrderId], map: "uq_orders_account_client")
  @@index([paperAccountId, requestedAt], map: "idx_orders_account_requested")
  @@index([symbolId], map: "idx_orders_symbol")
  @@map("orders")
}

model Execution {
  id             String   @id @db.Char(36)
  orderId        String   @map("order_id") @db.Char(36)
  paperAccountId Int      @map("paper_account_id") @db.UnsignedInt
  symbolId       Int      @map("symbol_id") @db.UnsignedInt
  side           String   @db.VarChar(8)
  quantity       Decimal  @db.Decimal(18, 8)
  price          Decimal  @db.Decimal(20, 8)
  executedAt     DateTime @map("executed_at")

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account PaperAccount @relation(fields: [paperAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  symbol  Symbol       @relation(fields: [symbolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([paperAccountId, executedAt], map: "idx_exec_account_time")
  @@index([symbolId, executedAt], map: "idx_exec_symbol_time")
  @@map("executions")
}
